// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SkillCategory {
  id       Int       @id @default(autoincrement())
  name     String @unique
  colNum   Int
  items    SkillsItems[]
  translations SkillCategoryTranslation[]
}

model SkillsItems {
  id    Int    @id @default(autoincrement())
  categoryId Int
  title String
  iconClass String?
  subTitle String?

  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model SkillCategoryTranslation {
  id         Int           @id @default(autoincrement())
  categoryId Int
  lang       String
  title      String

  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, lang])
}

model Experience {
  id           Int                      @id @default(autoincrement())
  company      String
  sortOrder    Int                      @default(0)
  slug         String?                  @unique
  kind         String                   @default("work") // work | education | course
  startDate    DateTime?
  endDate      DateTime? // null = ongoing
  url          String?
  stack        String                   @default("")
  related      String[]                 @default([]) // project slugs
  translations ExperienceTranslation[]
}

model ExperienceTranslation {
  id           Int         @id @default(autoincrement())
  experienceId Int
  lang         String
  time         String
  position     String
  skills       String      // legacy: JSON string of [{ id, title }], read by the pre-redesign site
  bullets      String[]    @default([])
  company      String? // per-language override of Experience.company
  stack        String? // per-language override of Experience.stack

  experience   Experience  @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, lang])
}

model HomePageContent {
  id    Int    @id @default(autoincrement())
  imageUrl String
  translations HomePageTranslation[]
}

model HomePageTranslation {
  id              Int              @id @default(autoincrement())
  title String
  subtitle String
  content String
  lang  String
  homePageContentId Int
  personDetailsId Int?

  personDetails  PersonDetails? @relation(fields: [personDetailsId], references: [id], onDelete: Cascade)
  homePageContent HomePageContent @relation(fields: [homePageContentId], references: [id], onDelete: Cascade)

  @@unique([homePageContentId, lang])
}

model PersonDetails {
  id    Int    @id @default(autoincrement())
  name  String
  email String
  phone String
  linkedin String
  github String
  cvLink String
  cvLinkText String // Added field for CV link text
  lang String

  homePageTranslations HomePageTranslation[]
}

model Project {
  id           Int                  @id @default(autoincrement())
  slug         String               @unique
  kind         String // work | school | other
  sortOrder    Int                  @default(0)
  featured     Boolean              @default(false)
  thumbnail    String?
  sourceUrl    String?
  liveUrl      String?
  stack        String[]
  language     String?
  libraries    String?
  platform     String?
  client       String?
  translations ProjectTranslation[]
}

model ProjectTranslation {
  id           Int     @id @default(autoincrement())
  projectId    Int
  lang         String
  name         String
  summary      String
  description  String[] // paragraphs
  role         String?
  thumbnailAlt String?
  platform     String? // per-language override of Project.platform
  libraries    String? // per-language override of Project.libraries
  decision     String? // case study: one hard decision and its trade-off
  result       String? // case study: outcome (real numbers only)
  next         String? // case study: what's next

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, lang])
}

model SkillGroup {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  sortOrder Int      @default(0)
  titleEn   String
  titleCs   String
  skills    Skill[]
}

model Skill {
  id        Int      @id @default(autoincrement())
  groupId   Int
  sortOrder Int      @default(0)
  nameEn    String
  nameCs    String
  usedIn    String[] // project slugs or experience slugs
  detailEn  String? // shown instead of usedIn links when set
  detailCs  String?

  group SkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, nameEn])
}
